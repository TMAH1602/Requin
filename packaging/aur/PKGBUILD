# Maintainer: Caleb Pelland <caleb.pelland@proton.me>

pkgname=requin
pkgver=0.1.0
pkgrel=1
pkgdesc="One-dimensional semiconductor device simulator"
arch=('x86_64' 'aarch64')
url="https://github.com/TMAH1602/Requin"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1')
makedepends=('cargo' 'nodejs' 'npm')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('7c64c96572c61572a5f6db72fa870197be645aa415974184deae75996bf1840e')

build() {
  cd "Requin-${pkgver}"
  npm ci
  npm run build
  cargo build --frozen --release --package requin
}

check() {
  cd "Requin-${pkgver}"
  cargo test --frozen --workspace
}

package() {
  cd "Requin-${pkgver}"

  install -Dm755 target/release/requin "${pkgdir}/usr/bin/requin"
  install -Dm644 src-tauri/icons/icon.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/requin.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm644 /dev/stdin \
    "${pkgdir}/usr/share/applications/requin.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Requin
Comment=One-dimensional semiconductor device simulator
Exec=requin
Icon=requin
Terminal=false
Categories=Education;Science;
StartupWMClass=Requin
EOF
}
