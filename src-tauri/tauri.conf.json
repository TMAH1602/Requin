{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Requin",
  "version": "0.1.0",
  "identifier": "science.requin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Requin", "width": 1500, "height": 940, "minWidth": 1040, "minHeight": 700, "decorations": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Education",
    "shortDescription": "One-dimensional semiconductor device simulator"
  }
}
